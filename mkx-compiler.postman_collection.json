{
  "info": {
    "name": "MKX Compiler API",
    "description": "API collection for the MKX Compiler service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verifies that the server is up and running."
      },
      "response": []
    },
    {
      "name": "Execute Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"#include <stdio.h>\\n\\nint main() {\\n  printf(\\\"Hello from MKX API!\\\\n\\\");\\n  return 0;\\n}\",\n  \"language\": \"c\",\n  \"input\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/mkx/v1/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mkx",
            "v1",
            "execute"
          ]
        },
        "description": "Compiles and executes code remotely.\\n\\nSupported languages: `c`, `cpp`, `python`, `javascript`."
      },
      "response": []
    },
    {
      "name": "Translate Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"console.log('Hello MKX');\",\n  \"targetLanguage\": \"python\",\n  \"apiKey\": \"{{geminiApiKey}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/mkx/v1/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mkx",
            "v1",
            "translate"
          ]
        },
        "description": "Translates code from one language to another using Gemini AI."
      },
      "response": []
    },
    {
      "name": "Generate Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Write a function to add two numbers\",\n  \"language\": \"javascript\",\n  \"apiKey\": \"{{geminiApiKey}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/mkx/v1/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mkx",
            "v1",
            "generate"
          ]
        },
        "description": "Generates source code from a natural language prompt using Gemini AI."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "geminiApiKey",
      "value": "YOUR_GEMINI_API_KEY",
      "type": "string"
    }
  ]
}
